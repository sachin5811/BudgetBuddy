# Database Configuration
DATABASE_URL=sqlite:///./budgetbuddy.db

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Admin Credentials
ADMIN_EMAIL=admin@budgetbuddy.com
ADMIN_PASSWORD=admin123

# CORS Origins (comma-separated or * for all)
CORS_ORIGINS=*

# Brevo (formerly Sendinblue) Transactional Email API (Recommended)
# Sign up at https://brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
BREVO_SENDER_EMAIL=your-verified-brevo-sender@domain.com
BREVO_SENDER_NAME=BudgetBuddy
